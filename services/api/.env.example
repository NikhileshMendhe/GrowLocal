# GrowLocal API — environment template (copy to .env and fill in)
# See docs/NODE_BACKEND_ARCHITECTURE.md §9

PORT=4000

# Postgres connection string. Can point at the existing Supabase Postgres
# instance (use its direct connection string, NOT the PostgREST URL).
DATABASE_URL=postgres://user:pass@host:5432/growlocal
# Set true when connecting to a hosted instance that requires TLS
# (Supabase direct, Neon, RDS). Leave false for local docker Postgres.
DATABASE_SSL=false

JWT_ACCESS_SECRET=change-me-min-32-random-chars
JWT_REFRESH_SECRET=change-me-different-min-32-random-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# CORS allow-list — exactly these origins may call the API (§10)
CUSTOMER_WEB_URL=https://app.growlocal.in
MERCHANT_WEB_URL=https://merchant.growlocal.in
ADMIN_WEB_URL=https://admin.growlocal.in

# S3-compatible object storage (R2 / S3 / MinIO). Leave unset to disable
# the uploads module (it will return 503 NotConfigured).
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PREFIX=growlocal-

# Admin seed — the only way an admins row is ever created (§5)
SEED_ADMIN_EMAIL=admin@growlocal.in
SEED_ADMIN_PASSWORD=change-me

# Optional
LOG_LEVEL=info
